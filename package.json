{
  "name": "starter",
  "version": "1.0.0-beta",
  "description": "Starting assembly for layout",
  "keywords": [
    "pug",
    "scss",
    "gulp 5",
    "webpack 5",
    "webp images",
    "svg sprite",
    "convert fonts"
  ],
  "main": "gulpfile.js",
  "scripts": {
